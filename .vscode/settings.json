{
  // Let the Kotlin LSP import the Gradle build (root JVM module + :web).
  "intellij.buildTool": "gradle",
  "intellij.workspace.reloadOnBuildFileSave": true,

  "files.exclude": {
    "**/.gradle": true,
    "**/.kotlin": true,
    "**/build": true
  },
  "files.watcherExclude": {
    "**/.gradle/**": true,
    "**/.kotlin/**": true,
    "**/build/**": true,
    "web-client/node_modules/**": true
  },
  "search.exclude": {
    "web-client/dist": true,
    "web-client/public/wasm": true
  },

  "[kotlin]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  }
}
